{
  "name": "kassa",
  "scopeName": "source.kassa",
  "fileTypes": [
    "kassa"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    { "include": "#operators" },
    {
      "name": "string.quoted.double.kassa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.kassa",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.kassa",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kassa"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kassa"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.kassa"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.kassa"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.kassa", "match": "-->" },
        { "name": "keyword.operator.assignment.kassa", "match": "=" },
        { "name": "keyword.operator.type-annotation.kassa", "match": ":" }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.kassa",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
