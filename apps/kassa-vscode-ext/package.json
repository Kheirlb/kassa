{
  "name": "kassa-vscode-ext",
  "displayName": "Kassa VSCode Extension",
  "publisher": "fnValves",
  "private": false,
  "repository": "github:kheirlb/kassa",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension/main.cjs",
  "scripts": {
    "build": "tsc -b tsconfig.json && node esbuild.mjs",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension/main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "kassa",
        "aliases": [
          "Kassa"
        ],
        "extensions": [
          ".kassa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kassa",
        "scopeName": "source.kassa",
        "path": "./syntaxes/kassa.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onFileSystem:builtin"
  ],
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@kassa/lang": "workspace:*",
    "langium": "4.2.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.27.3"
  },
  "files": [
    "out",
    "package.json",
    "README.md",
    "LICENSE",
    "language-configuration.json",
    "syntaxes"
  ]
}
