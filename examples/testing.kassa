import "symbols.kassa"
// import "symbols.kassa"
load "sample.csv" as mcmaster

// Tags here.
tag testTagRename { name: "Test Tags", color: green }
tagset testTags {
  name: "Test Tagsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss"
  tags: [testTagRename]
}

// Components here.
v0: Valve
// v0: Valve {
//   name: "Name defined here but not there"
// }
v1: Valve {}
v2: Valve { name: "Name" }
v3: Valve {
  name: "Valve with Tag",
  tags: [testTagRename],
  hardware: [mcmaster."47865K21", mcmaster."47865K21"]
}
cyl: Cylinder

// Custom symbol.
// symbol CustomTank
symbol CustomTank <Tank> {
  port inlet = {
    x: 35
    y: 50
    rot: 180
  }
}
// symbol CustomValve <Valve> { }

// Connections below.
v0 --> v1
--> v2 [outlet]
--> [inlet] v3
// v0 --> v1
// --> v2 [outlet]
// --> [inlet] v3

v00: Valve
--> v01: Valve
--> v02: Valve
--> v03: Valve
--> v04: Valve
--> v05: Valve
--> v06: Valve
--> v07: Valve
-> v08: CustomValve
// v00: Valve --> v01: Valve --> v02: Valve --> v03: Valve --> v04: Valve --> v05: Valve --> v06: Valve --> v07: Valve --> v08: Valve
// v00: Valve --> v01: Valve --> v02: Valve --> v03: Valve --> v04: Valve --> v05: Valve

conn1: NamedConnection
conn2: NamedConnection
vA: Valve [outlet] -> conn1 -> [inlet] vB: Valve

// Layout examples.
place v1 = {
  x: 60
  y: 30
  rot: 180
}
route conn1 = [
  out 100
  right 50
  auto
]
route (v2 [outlet] --> [inlet] v3) = [bend -30]

layout layoutA { 
  place v2 = {
    x: 10
    y: 10
    rot: 90
    mirror
  }
}

layout layoutName {
  place v0 = {
    x: 10
    y: 10
    rot: 90
    mirror
  }
  route conn1 = [
    out 100
    right 50
    auto
  ]
  route (v2 [outlet] --> [inlet] v3) = [bend -30]
}

group groupName {
  v00 --> v02
}

// Drawing example.
drawing optionSheetName {
  height: 11
  width: 8.5
  scale: 1.5
  titleBlock: {
    title: "Example P&ID"
    author: "Karl Parks"
    date: "2026"
  }
}

schematic Schematic1 {
	// Actually connect.
	groups [groupName]

	// And layout.
	use layoutA

	drawing: optionSheetName
}
