// ---- 2d symbols (components) ---
symbol Valve = {
  svg: "valve"
  label: bottom_mid
  port inlet  = { x: 30 y: 60 rot: 180 }
  port outlet = { x: 90 y: 60 rot: 0 }
}

symbol MotorValve <Valve> = {
  svg: "valve-m"
}

symbol Cylinder = {
  svg: "cylinder"
  label: bottom
  port p1 = { x: 60, y: 20, rot: 0 }
}

symbol Tank = {
  svg: "tank"
}

